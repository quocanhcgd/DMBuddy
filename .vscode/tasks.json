{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Printbuddy Connector: build Windows EXE",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\connector\\windows\\build-exe.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": {"kind": "build", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    },
    {
      "label": "Printbuddy Connector: install Python dependencies",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pip", "install", "-r", "${workspaceFolder}\\connector\\requirements.txt", "-r", "${workspaceFolder}\\connector\\windows\\requirements.txt"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
